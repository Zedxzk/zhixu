[Unit]
Description=Zhixu deterministic reminder scheduler
After=local-fs.target

[Service]
Type=simple
User=zhixu
Group=zhixu
UMask=0077
ExecStart=/opt/zhixu/current/venv/bin/zhixu-worker --database /var/lib/zhixu/zhixu.sqlite3
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/zhixu
InaccessiblePaths=/var/lib/zhixu-vault
SystemCallArchitectures=native
LogNamespace=zhixu
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
