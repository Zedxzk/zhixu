[Unit]
Description=Zhixu encrypted ordinary-state backups and restore drills

[Service]
Type=oneshot
User=zhixu
Group=zhixu
UMask=0077
LoadCredential=application_backup_passphrase:/etc/zhixu/credentials/application_backup_passphrase
ExecStart=/opt/zhixu/current/venv/bin/zhixu-backup --database /var/lib/zhixu/zhixu.sqlite3 --destination /var/backups/zhixu/application --passphrase-file %d/application_backup_passphrase
ExecStart=/opt/zhixu/current/venv/bin/zhixu-backup --database /var/lib/zhixu/qq/qq.sqlite3 --destination /var/backups/zhixu/qq --passphrase-file %d/application_backup_passphrase
ExecStart=/opt/zhixu/current/venv/bin/zhixu-backup --database /var/lib/zhixu/outbound/targets.sqlite3 --destination /var/backups/zhixu/outbound --passphrase-file %d/application_backup_passphrase
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
# The backup command opens sources with SQLite mode=ro. WAL databases still need
# directory access for SQLite's WAL/SHM coordination files while writers are active.
ReadWritePaths=/var/lib/zhixu /var/backups/zhixu/application /var/backups/zhixu/qq /var/backups/zhixu/outbound
InaccessiblePaths=/var/lib/zhixu-vault
LogNamespace=zhixu
