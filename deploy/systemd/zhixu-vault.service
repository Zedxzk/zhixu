[Unit]
Description=Zhixu isolated high-sensitivity vault
After=local-fs.target zhixu-pat-executor.service
Wants=zhixu-pat-executor.service
Before=zhixu-api.service

[Service]
Type=simple
User=zhixu-vault
Group=zhixu-vault
SupplementaryGroups=zhixu-vault-client
UMask=0077
EnvironmentFile=/etc/zhixu/runtime.conf
ExecStart=/opt/zhixu/current/venv/bin/zhixu-vault-runtime --database /var/lib/zhixu-vault/vault.sqlite3 --socket /run/zhixu/vault/vault.sock --socket-group zhixu-vault-client --allowed-user zhixu --issuer-public-key-file /etc/zhixu/grant_issuer_public.pem --passkey-rp-id ${ZHIXU_PASSKEY_RP_ID} --passkey-origin ${ZHIXU_PASSKEY_ORIGIN} --executor pat=/run/zhixu/integration/pat-executor.sock --audit-checkpoint-directory /var/backups/zhixu/vault-audit --audit-checkpoint-seconds 300 --audit-checkpoint-keep 90
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/zhixu/grant_issuer_public.pem
ReadWritePaths=/var/lib/zhixu-vault /run/zhixu/vault /var/backups/zhixu/vault-audit
InaccessiblePaths=/var/lib/zhixu
SystemCallArchitectures=native
LogNamespace=zhixu
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
