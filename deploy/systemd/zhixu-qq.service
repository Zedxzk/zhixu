[Unit]
Description=Zhixu Tencent QQ official bot channel
After=network-online.target zhixu-api.service
Wants=network-online.target
Requires=zhixu-api.service

[Service]
Type=simple
User=zhixu
Group=zhixu
UMask=0077
EnvironmentFile=/etc/zhixu/runtime.conf
LoadCredential=qq_app_id:/etc/zhixu/credentials/qq_app_id
LoadCredential=qq_client_secret:/etc/zhixu/credentials/qq_client_secret
LoadCredential=qq_field_key:/etc/zhixu/credentials/qq_field_key
LoadCredential=app_reference_key:/etc/zhixu/credentials/app_reference_key
LoadCredential=channel_service_token:/etc/zhixu/credentials/channel_service_token
ExecStart=/opt/zhixu/current/venv/bin/zhixu-qq --database /var/lib/zhixu/qq/qq.sqlite3 --account ${ZHIXU_QQ_ACCOUNT} --app-id-file %d/qq_app_id --client-secret-file %d/qq_client_secret --field-key-file %d/qq_field_key --reference-key-file %d/app_reference_key --channel-service-token-file %d/channel_service_token --bot-display-name ${ZHIXU_QQ_BOT_DISPLAY_NAME}
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/zhixu/qq
InaccessiblePaths=/var/lib/zhixu/zhixu.sqlite3 /var/lib/zhixu/zhixu.sqlite3-wal /var/lib/zhixu/zhixu.sqlite3-shm /var/lib/zhixu-vault
SystemCallArchitectures=native
LogNamespace=zhixu
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
