# Render both placeholders before installation. Never bind this template to 0.0.0.0.
server {
    listen __PRIVATE_IP__:443 ssl http2;
    server_name __PRIVATE_HOST__;
    server_tokens off;
    client_max_body_size 1m;

    ssl_certificate /etc/zhixu/tls/private-ingress.crt;
    ssl_certificate_key /etc/zhixu/tls/private-ingress.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location ^~ /internal/ {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8840;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }
}
